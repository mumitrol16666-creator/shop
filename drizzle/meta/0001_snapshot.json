        },
        "product_pricing_mode_check": {
          "name": "product_pricing_mode_check",
          "value": "\"product_pricing\".\"pricing_mode\" in ('auto', 'manual')"
        },
        "product_pricing_purchase_nonnegative_check": {
          "name": "product_pricing_purchase_nonnegative_check",
          "value": "\"product_pricing\".\"purchase_price\" >= 0 and \"product_pricing\".\"currency_rate\" > 0"
        },
        "product_pricing_fixed_costs_nonnegative_check": {
          "name": "product_pricing_fixed_costs_nonnegative_check",
          "value": "\"product_pricing\".\"purchase_price_kzt\" >= 0\n        and \"product_pricing\".\"china_delivery_kzt\" >= 0\n        and \"product_pricing\".\"cargo_kzt\" >= 0\n        and \"product_pricing\".\"customs_kzt\" >= 0\n        and \"product_pricing\".\"packaging_kzt\" >= 0\n        and \"product_pricing\".\"setup_kzt\" >= 0\n        and \"product_pricing\".\"marketing_kzt\" >= 0\n        and \"product_pricing\".\"other_costs_kzt\" >= 0\n        and \"product_pricing\".\"fixed_cost_kzt\" >= 0"
        },
        "product_pricing_percentages_check": {
          "name": "product_pricing_percentages_check",
          "value": "\"product_pricing\".\"tax_percent\" >= 0\n        and \"product_pricing\".\"bank_installment_percent\" >= 0\n        and \"product_pricing\".\"seller_percent\" >= 0\n        and \"product_pricing\".\"target_profit_percent\" >= 0"
        },
        "product_pricing_variable_percent_total_check": {
          "name": "product_pricing_variable_percent_total_check",
          "value": "\"product_pricing\".\"tax_percent\" + \"product_pricing\".\"bank_installment_percent\" + \"product_pricing\".\"seller_percent\" < 100"
        },
        "product_pricing_installment_months_nonnegative_check": {
          "name": "product_pricing_installment_months_nonnegative_check",
          "value": "\"product_pricing\".\"installment_months\" >= 0"
        },
        "product_pricing_prices_nonnegative_check": {
          "name": "product_pricing_prices_nonnegative_check",
          "value": "\"product_pricing\".\"recommended_price_kzt\" >= 0\n        and (\"product_pricing\".\"manual_price_kzt\" is null or \"product_pricing\".\"manual_price_kzt\" >= 0)\n        and \"product_pricing\".\"final_price_kzt\" >= 0"
        }
      }
    },
